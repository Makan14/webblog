# Configuration par défaut — développement local avec XAMPP (MySQL/MariaDB).
# Ne jamais mettre de secret de production ici : utiliser .env.local ou les variables de l'hébergeur.
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost
DATABASE_URL="mysql://root:@127.0.0.1:3306/webblog?serverVersion=mariadb-10.4.32&charset=utf8mb4"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
