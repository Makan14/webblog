{# Article complet : badge, titre, métadonnées, image principale, texte et galerie. #}
{% extends 'base.html.twig' %}
{% block title %}{{ article.nom }} — {{ app_name }}{% endblock %}
{% block meta_description %}{{ article.extrait }}{% endblock %}
{% block body %}
<article class="article-page">
    <header class="article-header">
        <span class="badge">{{ article.joueurLibelle }}</span>
        <h1>{{ article.nom }}</h1>
        <div class="article-meta">
            <span class="avatar" aria-hidden="true">{{ article.joueurLibelle|slice(0,1) }}</span>
            <span>{{ article.auteur ? article.auteur.nom : app_name }}</span>
            <span class="sep"></span>
            <time datetime="{{ article.dateCreation|date('Y-m-d') }}">{{ article.dateCreation|format_date('long') }}</time>
            <span class="sep"></span>
            <span>{{ 'article.read_time'|trans({'%minutes%': article.tempsLecture}) }}</span>
        </div>
    </header>

    {% set principale = article.imagePrincipale %}
    {% if principale %}
        <figure class="article-hero">
            <img src="{{ asset(principale.cheminPublic) }}" alt="{{ principale.alt ?: article.joueurLibelle }}">
        </figure>
    {% endif %}

    <div class="article-content">
        {% for paragraphe in article.contenu|split("\n\n") %}
            {% set ligne = paragraphe|trim %}
            {% if ligne starts with '## ' %}
                <h2>{{ ligne|slice(3) }}</h2>
            {% elseif ligne %}
                <p>{{ ligne|nl2br }}</p>
            {% endif %}
        {% endfor %}
    </div>

    {% if article.images|length > 1 %}
        <section class="article-gallery" aria-label="{{ 'article.gallery'|trans }}">
            <h2>{{ 'article.gallery'|trans }}</h2>
            <div class="gallery-grid">
                {% for image in article.images %}
                    {% if not image.principale %}
                        <figure>
                            <img src="{{ asset(image.cheminPublic) }}" alt="{{ image.alt ?: article.joueurLibelle }}" loading="lazy">
                        </figure>
                    {% endif %}
                {% endfor %}
            </div>
        </section>
    {% endif %}

    <a class="back-link" href="{{ path('app_home') }}">{{ 'article.back'|trans }}</a>
</article>
{% endblock %}
