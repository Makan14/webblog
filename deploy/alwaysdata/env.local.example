# Modèle SANS secret réel. Ne pas utiliser tel quel.
# Méthode recommandée : php deploy/alwaysdata/configure.php
# Méthode manuelle : copier ce contenu dans .env.local à la racine du projet,
# remplacer toutes les valeurs entre crochets, puis chmod 600 .env.local.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=[GENERER_AVEC_PHP_BIN2HEX_RANDOM_BYTES_32]
DEFAULT_URI=https://[COMPTE].alwaysdata.net
DATABASE_URL="mysql://[UTILISATEUR_MYSQL]:[MOT_DE_PASSE_ENCODE_URL]@mysql-[COMPTE].alwaysdata.net:3306/[COMPTE]_webblog?serverVersion=mariadb-11.4.0&charset=utf8mb4"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
TRUSTED_PROXIES="127.0.0.1,REMOTE_ADDR"
